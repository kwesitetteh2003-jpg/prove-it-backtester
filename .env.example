# Prove-It works with NO keys. Everything below is optional.

PORT=8787
HOST=0.0.0.0

# --- Natural-language -> rules via an OpenAI-compatible LLM (optional) ---
# Off by default: the built-in rule parser handles moving-average, RSI and breakout ideas.
# Vultr Serverless Inference is OpenAI-compatible (base URL below, per docs at api.vultrinference.com/docs).
# Pick a chat model from `GET /v1/models` (docs use e.g. deepseek-v4.1-flash) and set LLM_MODEL.
# Setting VULTR_INFERENCE_API_KEY turns the model parser on (LLM_ENABLED=false forces it off).
# If LLM_MODEL is empty, the first chat model from GET /v1/models is used.
VULTR_INFERENCE_API_KEY=
LLM_BASE_URL=https://api.vultrinference.com/v1
LLM_MODEL=
LLM_TIMEOUT_MS=25000

# --- Sandbox + abuse limits ---
SANDBOX_TIMEOUT_MS=20000
SANDBOX_HEAP_MB=256
MAX_CONCURRENT_SANDBOXES=4
RATE_LIMIT_PER_MIN=40
# Set to "off" to skip the empty-network-namespace layer even if the host supports it
# SANDBOX_NET_ISOLATION=off
